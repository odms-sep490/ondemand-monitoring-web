# Copy to .env and adjust as needed. See src/config/env.ts.

VITE_API_BASE_URL=http://localhost:8080
VITE_AWS_COGNITO_DOMAIN=
VITE_AWS_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_SIGN_IN=

# Mock API (src/mocks/README.md): true forces mock, false forces real
# backend, unset defaults to on in `npm run dev`.
VITE_USE_MOCK_API=true

# Hybrid mode: while VITE_USE_MOCK_API=true, these "METHOD /path" routes go to
# the real backend (`*` = one path segment, trailing `*` = any suffix).
VITE_REAL_API_ROUTES=GET /api/admin/users*,PATCH /api/admin/users/*/status,POST /api/admin/accounts,GET /api/users/me,PATCH /api/users/me,GET /api/services*,GET /api/checklists/catalog,POST /api/services,PUT /api/services/*,DELETE /api/services/*,GET /api/preferred-times*,POST /api/preferred-times,PUT /api/preferred-times/*,DELETE /api/preferred-times/*,GET /api/services/pricing-estimate,POST /api/pricing/checklist-quote,GET /api/services/requirement-suggestions,GET /api/service-deliverables*,GET /api/category-services*,GET /api/zones,POST /api/orders,GET /api/orders/mine,GET /api/orders/*,GET /api/orders/*/quote,POST /api/orders/*/quotes/*/accept,GET /api/orders/*/invoice,GET /api/customer/mission-history*,GET /api/customer/available-media,GET /api/customer/media-notifications,GET /api/customer/missions/*/media,GET /api/customer/missions/*/media/*,GET /api/customer/missions/*/media-status,GET /api/media/*/download,GET /api/admin/checklists*,POST /api/admin/checklists,PUT /api/admin/checklists/*,PATCH /api/admin/checklists/*/status,GET /api/admin/services/*/checklists,POST /api/admin/services/*/checklists,PUT /api/admin/services/*/checklists/order,PUT /api/admin/services/*/checklists/*/pricing,DELETE /api/admin/services/*/checklists/*,GET /api/admin/pricing/services/*/default-price,POST /api/admin/pricing/service-preview,GET /api/admin/pricing-policies*,POST /api/admin/pricing-policies*,PUT /api/admin/pricing-policies*,POST /api/admin/pricing-policies/*/clone,POST /api/admin/pricing-policies/*/publish,GET /api/manager/orders/*/pricing,GET /api/manager/orders/*/readiness,PUT /api/manager/orders/*/readiness/*,GET /api/manager/orders/*/invoice,PATCH /api/manager/orders/*/checklist-items/*,PUT /api/manager/orders/*/quotes/draft,POST /api/manager/orders/*/quotes/*/approve,POST /api/invoices/*/payments/deposit,POST /api/invoices/*/payments/final,GET /api/payments/by-reference/*,GET /api/flight-area-assessment
